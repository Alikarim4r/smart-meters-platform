# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API.
# Use the anon (publishable) key only — never the service_role key.
# .env.local is gitignored; scripts/load_env.sh sources it when present.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Local run scripts default to staging UX when unset.
APP_ENV=staging
