# Smart Meters production release environment.
# Copy to .env.production.local and fill ONLY from the dedicated Smart Meters
# Production Supabase project. Never reuse staging or Daily Checklists values.
# Keep .env.production.local gitignored and never commit real keys.

SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
SUPABASE_ANON_KEY=
APP_ENV=production
